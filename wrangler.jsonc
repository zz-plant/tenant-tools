{
  "name": "tenant-notice-builder",
  "compatibility_date": "2026-01-23",
  "minify": true,
  "assets": {
    "directory": "./dist"
  },
  // Private evidence photos. Create once with: wrangler r2 bucket create building-ledger-evidence
  // Never enable public access on this bucket. Photos are served only through signed, key-gated links.
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "building-ledger-evidence"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SUBMISSIONS_KV",
      "id": "REPLACE_WITH_KV_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_ID"
    }
  ]
}
