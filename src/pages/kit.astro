---
import "../styles/global.css";
import { getProvisionInEffect } from "../data/rules";
import { formatDate } from "../lib/dateUtils";
import { qrSvg } from "../lib/qr";
import SeoHead from "../components/SeoHead.astro";
import AppHeader from "../components/AppHeader.astro";
import HelpResources from "../components/HelpResources.astro";

// The QR code uses this site's address, so the page is built for each request.
export const prerender = false;

// Printed flyers must not point at plain http. Local test hosts keep their own address.
const isLocalHost = ["localhost", "127.0.0.1"].includes(Astro.url.hostname);
const rightsUrl = `${isLocalHost ? Astro.url.origin : `https://${Astro.url.host}`}/rights`;
const rightsQr = qrSvg(rightsUrl);
// Fear of retaliation is the first reason neighbors stay away. The kit says what the law protects.
const retaliationRule = getProvisionInEffect("retaliation", formatDate(new Date()));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead
      title="Start a building group | Tenant Tools"
      description="Printable flyer and first-meeting checklist for residents who want to work on building problems together."
      canonicalPath="/kit"
      imagePath="/og/home.png"
      imageAlt="Tenant Tools starter kit for a building group"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AppHeader subtitle="Start a building group" backHref="/" backLabel="Notice builder" />
    <div class="page">
      <main class="layout print-report" id="main">
        <section class="panel report-sheet kit-sheet">
          <div class="no-print">
            <h1>Start a building group</h1>
            <p class="helper">Print the flyer. Hold one meeting. Then keep a shared record of the problems and the dates. Information only. Not legal advice.</p>
            <div class="report-actions">
              <button class="button" type="button" data-print>Print the flyer and checklist</button>
              <a class="button button-secondary" href="/rights">Short guide to tenant rules</a>
            </div>
            <p class="helper">Before you post flyers, talk with neighbors you trust about safety. You can hand flyers to neighbors instead of posting them.</p>
          </div>

          <div class="kit-cards no-print">
            <section class="helper-card kit-card">
              <h2>Before you start</h2>
              <ul class="submission-detail-list">
                <li>You do not need the app for the first meeting. The flyer and the checklist work on paper.</li>
                <li>
                  To keep a shared record, your building needs to be on Tenant Tools. Open the
                  <a href="/#builder">notice builder</a> and look at the building list.
                </li>
                <li>
                  Not on the list? Ask the person who shared Tenant Tools with you. A steward adds the building and gives your
                  group a building key. Share the key in person, not in a public post.
                </li>
              </ul>
            </section>

            {retaliationRule && (
              <section class="helper-card kit-card">
                <h2>Organizing is protected</h2>
                <p>{retaliationRule.summary}</p>
                <ul class="submission-detail-list">
                  {retaliationRule.details.map((detail) => <li>{detail}</li>)}
                  <li>If something changes after you ask for repairs or join the group, write down the date. Talk to legal aid or a tenant union.</li>
                </ul>
                <p class="rule-meta">
                  Rule: {retaliationRule.section}.{" "}
                  {retaliationRule.sources.map((source, index) => (
                    <>
                      {index > 0 && " · "}
                      <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
                    </>
                  ))}
                </p>
              </section>
            )}
          </div>

          <article class="kit-flyer">
            <p class="kit-flyer-band">Tenant meeting</p>
            <h2 class="kit-flyer-title">Problems in our building?</h2>
            <p class="kit-flyer-lead">Neighbors can work on them together.</p>
            <ul class="kit-flyer-list">
              <li>Many of us have the same problems: heat, leaks, pests, repairs.</li>
              <li>One letter from many households is harder to ignore than one call.</li>
              <li>We keep a shared record with dates. No names are needed.</li>
            </ul>
            <dl class="kit-flyer-meeting">
              <div><dt>Date</dt><dd></dd></div>
              <div><dt>Time</dt><dd></dd></div>
              <div><dt>Place</dt><dd></dd></div>
            </dl>
            <ul class="kit-flyer-expect">
              <li>Come and listen. You do not have to speak or sign anything.</li>
              <li>Free. Run by neighbors, not by management.</li>
              <li>Bring a list of problems in your home, with dates if you have them.</li>
              <li>Chicago law protects tenants who ask for repairs or join a tenant group.</li>
            </ul>
            <div class="kit-flyer-qr">
              <div class="kit-qr" role="img" aria-label={`QR code for ${rightsUrl}`} set:html={rightsQr} />
              <div>
                <p><strong>Chicago tenant rules, in short</strong></p>
                <p>Scan the code, or go to:</p>
                <p class="kit-url">{rightsUrl}</p>
              </div>
            </div>
          </article>

          <article class="kit-checklist">
            <h2>First meeting checklist</h2>
            <ol>
              <li>Meet in a place that feels safe. Not the management office.</li>
              <li>Use a paper sign-in sheet only if people agree. Keep it with the group. Do not put it in the app.</li>
              <li>Go around the room. Each person names the problems they have. Write the problem, not the unit.</li>
              <li>Add each problem to the building record, or write it down to add later. Neighbors with the same problem tap "Me too".</li>
              <li>Choose one to three problems to start with.</li>
              <li>Write the joint letter together. Count the households that sign. The letter shows only the number.</li>
              <li>Choose a reply date. Plan the next meeting for soon after that date.</li>
              <li>Choose one or two people to keep the building key. They share it in person and ask for a new key if it leaks.</li>
              <li>Agree on safety: no names or unit numbers in the group chat. If management asks about the group, you do not have to answer. You can say: "Neighbors are meeting about repairs."</li>
              <li>Before everyone leaves, say the date of the next meeting.</li>
            </ol>
          </article>

          <article class="kit-steps no-print">
            <h2>After the first meeting</h2>
            <ol>
              <li><strong>Record:</strong> add problems and dates to the building record. Add dated facts as things happen.</li>
              <li><strong>Ask together:</strong> send the joint letter from the building dashboard.</li>
              <li><strong>Follow up:</strong> check "Needs follow-up" on the dashboard. Add replies and missed dates.</li>
              <li><strong>Inspections:</strong> plan a group 311 day for problems that qualify.</li>
              <li><strong>Meet again:</strong> print the meeting report. Log wins when problems are fixed.</li>
            </ol>
          </article>

          <section class="no-print">
            <HelpResources />
          </section>
        </section>
      </main>
    </div>
    <script>
      document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>
