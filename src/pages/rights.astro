---
import "../styles/global.css";
import { formatDateForLocale, getAllProvisionCards, getReferenceRuleCards, type RuleCard } from "../data/rules";
import { rightsLanguages, rightsStrings } from "../data/i18n/strings";
import { formatDate } from "../lib/dateUtils";
import { createTranslator, getCatalog, lookupTranslation } from "../lib/i18n/translate";
import SeoHead from "../components/SeoHead.astro";
import AppHeader from "../components/AppHeader.astro";
import HelpResources from "../components/HelpResources.astro";

// Rules depend on the date (heat season, rules that start later), so this page is not prerendered.
export const prerender = false;

const today = formatDate(new Date());
const requested = Astro.url.searchParams.get("lang") ?? "en";
const lang = rightsLanguages.some((entry) => entry.id === requested) ? requested : "en";
// Reviewer preview shows draft translations. Residents never get it from a normal link.
const preview = lang !== "en" && Astro.url.searchParams.get("preview") === "drafts";
const translator = createTranslator(lang, { preview });
const { t } = translator;
// Dates and the page language follow the page text: Spanish only when the guide's text is translated.
const titleTranslated =
  lang !== "en" &&
  Boolean(lookupTranslation(getCatalog(lang), "rights.title", rightsStrings["rights.title"], { includeDrafts: preview }));
const textLang = titleTranslated ? lang : "en";
const locale = textLang === "es" ? "es-US" : "en-US";
const s = (key: keyof typeof rightsStrings, vars?: Record<string, string | number>) => t(key, rightsStrings[key], vars);

const localizeProvision = (card: RuleCard): RuleCard => {
  const provisionId = card.id.split(".").pop() ?? card.id;
  return {
    ...card,
    title: t(`rule.${provisionId}.title`, card.title),
    summary: t(`rule.${provisionId}.summary`, card.summary),
    details: card.details?.map((detail, index) => t(`rule.${provisionId}.detail.${index}`, detail)),
  };
};

const sections: Array<{ title: string; cards: RuleCard[] }> = [
  { title: s("rights.section.rlto"), cards: getAllProvisionCards(today).map(localizeProvision) },
  { title: s("rights.section.reference"), cards: getReferenceRuleCards(today, { t, locale }) },
];
const stats = translator.stats();
const showUnreviewedNotice = lang !== "en" && !preview && stats.shown === 0;
---

<!DOCTYPE html>
<html lang={textLang}>
  <head>
    <SeoHead
      title="Know your rights | Building Ledger"
      description="Printable short guide to Chicago tenant rules, with sources and where to get help."
      canonicalPath="/rights"
      imagePath="/og/home.png"
      imageAlt="Building Ledger printable rights sheet"
      noindex={preview}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AppHeader subtitle="Know your rights" backHref="/" backLabel="Notice builder" />
    <div class="page">
      <main class="layout print-report" id="main">
        <section class="panel report-sheet rights-sheet">
          <nav class="no-print rights-languages" aria-label="Language">
            {rightsLanguages.map((entry) => (
              <a href={entry.id === "en" ? "/rights" : `/rights?lang=${entry.id}`} lang={entry.id} aria-current={entry.id === lang ? "page" : undefined}>
                {entry.label}
              </a>
            ))}
          </nav>

          {preview && (
            <div class="evidence-warning no-print" role="note" lang="en">
              <p class="evidence-warning-title">Draft translation for review</p>
              <p>{stats.drafts} draft lines are shown. They are not checked yet. Do not share this page with residents.</p>
              <p>Send corrections in the translation spreadsheet. See docs/translations.md. <a href={`/rights?lang=${lang}`}>Leave preview</a>.</p>
            </div>
          )}

          {showUnreviewedNotice && (
            <div class="helper-card no-print" role="note">
              <p lang="en">This guide is not reviewed in this language yet, so it is shown in English.</p>
              {lang === "es" && (
                <p lang="en">
                  The City of Chicago has an official Spanish summary:{" "}
                  <a href="https://www.chicago.gov/content/dam/city/depts/doh/RLTO/RLTO%20Summary_2023_ES-US.pdf" target="_blank" rel="noreferrer" hreflang="es">RLTO Summary, Spanish (PDF)</a>.
                </p>
              )}
            </div>
          )}

          <header class="report-header">
            <p class="eyebrow">Building Ledger</p>
            <h1>{s("rights.title")}</h1>
            <p>{s("rights.intro")}</p>
            <p>{s("rights.date", { date: formatDateForLocale(today, locale) })}</p>
          </header>
          <div class="no-print report-actions">
            <button class="button" type="button" data-print>{s("rights.print")}</button>
            <a class="button button-secondary" href="/">{s("rights.back")}</a>
          </div>

          {sections.map((section) => (
            <section class="rights-section">
              <h2>{section.title}</h2>
              <ul class="rule-cards">
                {section.cards.map((card) => (
                  <li class="rule-card">
                    <h3>{card.title}</h3>
                    {card.section && <p class="rule-meta">{card.section}</p>}
                    <p>{card.summary}</p>
                    {card.details && (
                      <ul class="rule-details">
                        {card.details.map((detail) => <li>{detail}</li>)}
                      </ul>
                    )}
                    {card.upcoming && (
                      <div class="rule-upcoming">
                        <p>
                          <strong>{s("rights.starting", { date: formatDateForLocale(card.upcoming.startDate, locale) })}</strong> {card.upcoming.summary}
                        </p>
                      </div>
                    )}
                    <ul class="rule-sources">
                      {card.sources.map((source) => (
                        <li>
                          <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            </section>
          ))}

          <section class="rights-section">
            <HelpResources headingLevel="h2" t={t} locale={locale} />
          </section>
        </section>
      </main>
    </div>
    <script>
      document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>
