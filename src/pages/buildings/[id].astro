---
import "../../styles/global.css";
import { issueOptions, issueShortLabels } from "../../data/noticeData";
import { isAccessKeyValid, isBuildingAccessValid } from "../../lib/access";
import { RESIDENT_KEY_COOKIE, STEWARD_KEY_COOKIE } from "../../lib/api/requestGuard";
import { formatResidentReportCount, type BuildingSubmission } from "../../lib/buildingDashboard";
import { loadBuildingDetail } from "../../lib/buildingDetail";
import {
  buildFollowUpItems,
  buildRecordLine,
  daysOpen,
  nextStepButtonLabel,
  nextStepForRecord,
  summarizeWins,
  type RecordNextStep,
} from "../../lib/followUp";
import { describeCanvass } from "../../lib/canvass";
import { listCanvasses } from "../../lib/storage/canvass";
import { listNoticeContactLines } from "../../lib/noticeContacts";
import { getNoticeContacts } from "../../lib/storage/noticeContacts";
import { submissionStatusLabels, type SubmissionStatus } from "../../lib/submissions";
import { buildIssuePatterns } from "../../lib/issuePatterns";
import { formatIssueLabel } from "../../lib/noticeUtils";
import { formatDate, formatTimelineDate } from "../../lib/dateUtils";
import { buildBuildingDashboardUrl, buildSubmissionDetailsUrl } from "../../lib/navigation";
import SeoHead from "../../components/SeoHead.astro";
import AccessKeyPanel from "../../components/AccessKeyPanel.astro";
import AppHeader from "../../components/AppHeader.astro";
import BlockSkyline from "../../components/BlockSkyline.astro";
import StopLine from "../../components/StopLine.astro";
import StreetSign from "../../components/StreetSign.astro";

export const prerender = false;

const { id } = Astro.params;
const kv = Astro.locals.env?.SUBMISSIONS_KV;
const url = new URL(Astro.request.url);
const accessKey = Astro.cookies.get(RESIDENT_KEY_COOKIE)?.value ?? url.searchParams.get("key");
const stewardKey = Astro.cookies.get(STEWARD_KEY_COOKIE)?.value ?? url.searchParams.get("stewardKey");
const requiredStewardKey = Astro.locals.env?.STEWARD_KEY;
const buildingId = decodeURIComponent(id ?? "");

const hasAccess = isBuildingAccessValid(buildingId, accessKey, Astro.locals.env ?? {});
const hasAccessAttempt = Boolean(accessKey && accessKey.trim());
const isSteward = isAccessKeyValid(stewardKey, requiredStewardKey);

const issueIds = new Set(issueOptions.map((issue) => issue.id));
const statusIds: SubmissionStatus[] = ["open", "resolved", "archived"];

const issueFilterRaw = url.searchParams.get("issue") || "all";
const issueFilter = issueIds.has(issueFilterRaw) ? issueFilterRaw : "all";
const statusLabels = submissionStatusLabels;

const clearFiltersUrl = buildBuildingDashboardUrl({ buildingId });
const buildFilterUrl = (nextIssue: string) =>
  nextIssue === "all" ? clearFiltersUrl : `${clearFiltersUrl}?issue=${encodeURIComponent(nextIssue)}`;

const today = formatDate(new Date());
// Archived records are left out of the full reads: they are not followed up, and wins are logged on open or resolved records.
const detail =
  hasAccess && kv && buildingId ? await loadBuildingDetail(kv, buildingId, { statuses: ["open", "resolved"] }) : null;
const submissions: BuildingSubmission[] = detail?.summaries ?? [];
const followUpItems = detail ? buildFollowUpItems(detail.records, detail.eventsByRecord, today) : [];
const wins = detail ? summarizeWins(detail.records, detail.eventsByRecord) : { total: 0, afterLetter: 0, after311: 0 };
const latestCanvass = detail && kv ? (await listCanvasses(kv, buildingId))[0] ?? null : null;
const noticeContacts = detail && kv ? await getNoticeContacts(kv, buildingId) : null;

const filtered = submissions
  .filter((record) => (issueFilter === "all" ? true : record.issue === issueFilter))
  .sort((left, right) => right.createdAt.localeCompare(left.createdAt));

const maxVisible = 60;
const visibleSubmissions = filtered.slice(0, maxVisible);

const grouped: Record<SubmissionStatus, BuildingSubmission[]> = {
  open: [],
  resolved: [],
  archived: [],
};

for (const record of visibleSubmissions) {
  grouped[record.status].push(record);
}

// Records a steward can merge a duplicate into: same issue type, not already merged.
const mergeTargetsFor = (record: BuildingSubmission) =>
  submissions.filter(
    (candidate) => candidate.id !== record.id && candidate.issue === record.issue && !candidate.mergedInto
  );

const patterns = buildIssuePatterns(submissions, today);
const totalFiltered = filtered.length;
const draftNoticeUrl = `/?building=${encodeURIComponent(buildingId)}#builder`;

// Each open row shows its days open and its one next step. The oldest problem is listed first.
const recordById = new Map((detail?.records ?? []).map((record) => [record.id, record]));
const nextStepFor = (summary: BuildingSubmission): RecordNextStep | null => {
  const record = recordById.get(summary.id);
  if (!record || summary.status !== "open" || summary.mergedInto) {
    return null;
  }
  return nextStepForRecord(record, detail?.eventsByRecord.get(record.id) ?? [], today, followUpItems);
};
const lineFor = (summary: BuildingSubmission) => {
  const record = recordById.get(summary.id);
  return record && summary.status === "open" && !summary.mergedInto
    ? buildRecordLine(record, detail?.eventsByRecord.get(record.id) ?? [], today)
    : null;
};
grouped.open.sort((left, right) => daysOpen(right.startDate, today) - daysOpen(left.startDate, today));

// The sign shows one step a resident can take now: the oldest open problem with a step that is ready.
const signRecord = grouped.open
  .filter((record) => !record.mergedInto)
  .map((record) => ({ record, step: nextStepFor(record) }))
  .find((entry) => entry.step?.state === "ready");
const nextLocked = grouped.open
  .map((record) => ({ record, step: nextStepFor(record) }))
  .find((entry) => entry.step?.state === "locked");
const issueCounts = issueOptions
  .map((opt) => ({ ...opt, count: submissions.filter((s) => s.issue === opt.id).length }))
  .filter((opt) => opt.count > 0 || issueFilter === opt.id);
const groupTools = [
  { href: `${clearFiltersUrl}/meeting`, label: "Meeting report", note: "One page for your next tenant meeting." },
  { href: `${clearFiltersUrl}/letter`, label: "Joint letter", note: "One repair letter, signed with a household count." },
  { href: `${clearFiltersUrl}/311`, label: "Group 311 day", note: "Plan a day when neighbors call 311 together." },
  { href: `${clearFiltersUrl}/export`, label: "Printable summary", note: "Every record, for an inspector or legal aid." },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead
      title="Building dashboard | Tenant Tools"
      description="Private building dashboard for resident issue summaries."
      canonicalPath={`/buildings/${encodeURIComponent(buildingId)}`}
      imagePath="/og/private-dashboard.png"
      imageAlt="Tenant Tools private resident dashboard preview"
      noindex={true}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AppHeader
      title="Tenant Tools"
      subtitle={hasAccess ? "Resident access" : "Residents only"}
      backHref="/"
      backLabel="Home"
      statusBadge={hasAccess ? "Verified resident access" : "Access key needed"}
      isSteward={isSteward}
    />
    <div class="page">
      <header class="hero hero-single">
        <div class="hero-main">
          {buildingId ? <StreetSign address={buildingId} as="h1" /> : <h1>Building page</h1>}
          {!hasAccess && <p class="tagline">Residents only. Open the link from your building group, or enter the key.</p>}
        </div>
      </header>

      {hasAccess && kv && (
        <section class="next-up" aria-labelledby="next-up-title">
          {signRecord?.step ? (
            <div class="next-sign">
              <h2 id="next-up-title">{signRecord.step.label}</h2>
              <p>
                {formatIssueLabel(signRecord.record.issueLabel)}. Day {daysOpen(signRecord.record.startDate, today)}.{" "}
                {signRecord.step.note ?? "The dates from the record are filled in for you."}
              </p>
              <a class="button" href={signRecord.step.href}>{nextStepButtonLabel(signRecord.step)}</a>
            </div>
          ) : (
            <div class="next-calm">
              <h2 id="next-up-title">Nothing to send today</h2>
              <p>
                {nextLocked?.step
                  ? `${nextLocked.record.issueLabel}: ${nextLocked.step.label}.`
                  : grouped.open.length > 0
                    ? "Add a dated fact on a record when something changes."
                    : "No open problems are saved for this building."}
              </p>
            </div>
          )}
          <div class="next-actions">
            <a class="button" href={draftNoticeUrl}>Report a problem</a>
            <a class="button button-secondary" href="#records">Me too on a problem</a>
          </div>
        </section>
      )}

      <main class="layout" id="main">
        <section class="panel dashboard-grid" id="records" aria-labelledby="records-title">
          {!hasAccess ? (
            <AccessKeyPanel
              title="Key required"
              helperLines={[
                "Residents only.",
                `Ask a steward for the current key for ${buildingId || "this building"}.`,
                "Paste the key below and select Continue.",
              ]}
              warning="Do not share the key publicly."
              errorMessage={hasAccessAttempt ? "Key does not match this building." : ""}
              backLabel="Back to notice builder"
            />
          ) : !kv ? (
            <div>
              <h2>Ledger storage is not configured.</h2>
              <p class="helper">Connect the submission store to load building activity.</p>
            </div>
          ) : (
            <>
              <div class="board-head">
                <h2 id="records-title">Open problems</h2>
                <p class="board-count tabular" data-status-count="open">{formatResidentReportCount(grouped.open.length)}</p>
              </div>
              <p class="helper">Tap “Me too” if you have the same problem. No names are saved.</p>

              {issueCounts.length > 1 && (
                <nav class="quick-filter-bar" aria-label="Show one problem type">
                  <a href={buildFilterUrl("all")} class="fact-tag" aria-current={issueFilter === "all" ? "true" : undefined}>
                    All ({submissions.length})
                  </a>
                  {issueCounts.map((opt) => (
                    <a
                      href={buildFilterUrl(opt.id)}
                      class="fact-tag issue-filter"
                      data-issue={opt.id}
                      aria-current={issueFilter === opt.id ? "true" : undefined}
                    >
                      {issueShortLabels[opt.id] ?? formatIssueLabel(opt.label)} ({opt.count})
                    </a>
                  ))}
                </nav>
              )}

              {statusIds.map((status) => (
                <section
                  class="status-group"
                  data-status-group={status}
                  hidden={status !== "open" && grouped[status].length === 0}
                >
                  {status !== "open" && (
                    <div class="status-header">
                      <h3>{statusLabels[status]}</h3>
                      <span class="board-count tabular" data-status-count={status}>{formatResidentReportCount(grouped[status].length)}</span>
                    </div>
                  )}
                  {status === "open" && grouped.open.length === 0 && (
                    <p class="helper">{totalFiltered === 0 && issueFilter !== "all" ? "No problems of this type." : "No open problems."}</p>
                  )}
                  {grouped[status].map((record) => {
                    const step = nextStepFor(record);
                    const recordUrl = buildSubmissionDetailsUrl({ submissionId: record.id });
                    return (
                      <article
                        class="problem-row"
                        data-issue={record.issue}
                        data-submission-id={record.id}
                        data-current-status={record.status}
                      >
                        <span class="problem-swatch" aria-hidden="true"></span>
                        <div class="problem-main">
                          <h3 class="problem-title"><a href={recordUrl}>{formatIssueLabel(record.issueLabel)}</a></h3>
                          <p class="problem-meta">
                            Started {record.startDate ? formatTimelineDate(record.startDate) : "date not listed"}.{" "}
                            Me too: <span data-report-count={record.id} title="Small counts are hidden for privacy">{formatResidentReportCount(record.reportCount)}</span>
                          </p>
                          {lineFor(record) && <StopLine stops={lineFor(record) ?? []} compact />}
                          {step && step.state !== "ready" && <p class="problem-next">{step.label}</p>}
                          {record.mergedInto && <p class="problem-next">Merged into another record.</p>}
                        </div>
                        {status === "open" && (
                          <p class="problem-days" aria-label={`${daysOpen(record.startDate, today)} days open`}>
                            <b class="tabular">{daysOpen(record.startDate, today)}</b>
                            <span>{daysOpen(record.startDate, today) === 1 ? "day" : "days"}</span>
                          </p>
                        )}
                        <div class="problem-actions">
                          {!record.mergedInto && (
                            <button
                              class="button button-secondary button-compact"
                              type="button"
                              data-report-button
                              data-submission-id={record.id}
                              data-default-label="Me too"
                            >
                              Me too
                            </button>
                          )}
                          {step?.state === "ready" ? (
                            <a class="button button-compact" href={step.href}>{step.label}</a>
                          ) : (
                            <a class="button button-secondary button-compact" href={recordUrl}>Open record</a>
                          )}
                        </div>
                        <p class="helper problem-status" data-report-status={record.id} role="status" aria-live="polite"></p>
                        {isSteward && !record.mergedInto && (
                          <div class="steward-row">
                            <label class="steward-inline">
                              <span>Update status</span>
                              <select class="input" data-status-select data-submission-id={record.id}>
                                {statusIds.map((option) => (
                                  <option value={option} selected={record.status === option}>
                                    {statusLabels[option]}
                                  </option>
                                ))}
                              </select>
                              <button
                                class="button button-compact"
                                type="button"
                                data-status-save
                                data-submission-id={record.id}
                                data-default-label="Save"
                              >
                                Save
                              </button>
                            </label>
                            <p class="helper" data-status-note={record.id} role="status" aria-live="polite"></p>
                            <p class="helper">Use this only after residents confirm the issue is fixed.</p>
                            {mergeTargetsFor(record).length > 0 && (
                              <label class="steward-inline">
                                <span>Duplicate of</span>
                                <select class="input" data-merge-select data-submission-id={record.id}>
                                  <option value="">Choose the main record</option>
                                  {mergeTargetsFor(record).map((target) => (
                                    <option value={target.id}>
                                      Started {target.startDate || "date not listed"} ({statusLabels[target.status]})
                                    </option>
                                  ))}
                                </select>
                                <button
                                  class="button button-compact button-secondary"
                                  type="button"
                                  data-merge-save
                                  data-submission-id={record.id}
                                >
                                  Merge
                                </button>
                              </label>
                            )}
                            <p class="helper" data-merge-note={record.id} role="status" aria-live="polite"></p>
                          </div>
                        )}
                      </article>
                    );
                  })}
                </section>
              ))}

              {filtered.length > visibleSubmissions.length && (
                <p class="helper">Showing the newest {visibleSubmissions.length} of {filtered.length} records. The printable summary has all of them.</p>
              )}
              <p class="helper">
                Wins logged: {wins.total}. Small counts show as &lt;3 to protect residents. Counts are resident-reported and not verified.
              </p>
              {patterns.rows.length > 0 && (
                <details class="helper-card patterns">
                  <summary>Records started each month</summary>
                  <div class="helper-card-body">
                    <p class="helper">Last 6 months, by problem type. A problem that comes back shows in many months.</p>
                    <div class="table-scroll">
                      <table class="report-table">
                        <thead>
                          <tr>
                            <th scope="col">Issue</th>
                            {patterns.months.map((month) => <th scope="col">{month.label}</th>)}
                            <th scope="col">Total</th>
                            <th scope="col">Open now</th>
                          </tr>
                        </thead>
                        <tbody>
                          {patterns.rows.map((row) => (
                            <tr>
                              <th scope="row">{row.issueLabel}</th>
                              {row.counts.map((count) => <td>{count}</td>)}
                              <td>{row.total}</td>
                              <td>{row.open}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p class="helper">Counts under 3 show as &lt;3 to protect residents. Merged duplicates are not counted.</p>
                  </div>
                </details>
              )}
            </>
          )}
        </section>

        <aside class="panel sidebar-panel" aria-labelledby="aside-title">
          {!hasAccess ? (
            <>
              <h2 id="aside-title">Why this is private</h2>
              <ul class="submission-detail-list">
                <li>This page never shows names or unit numbers.</li>
                <li>Photos stay private.</li>
                <li>Keys keep landlords and strangers out.</li>
              </ul>
            </>
          ) : (
            <>
              <h2 id="aside-title">Group tools</h2>
              <ul class="tool-list">
                {[
                  ...groupTools,
                  ...(isSteward
                    ? [
                        { href: `${clearFiltersUrl}/canvass`, label: "Canvass tally", note: "Count doors knocked. Counts only." },
                        { href: `${clearFiltersUrl}/contacts`, label: "Who to send notices to", note: "Owner, manager, and notice address." },
                        { href: "/steward", label: "Steward tools", note: "Keys, exports, and emergency wipe." },
                      ]
                    : []),
                ].map((tool) => (
                  <li>
                    <a href={tool.href}>
                      <span class="tool-name">{tool.label}</span>
                      <span class="tool-note">{tool.note}</span>
                      <svg class="tool-arrow" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
              {latestCanvass && (
                <p class="helper"><strong>Latest canvass:</strong> {describeCanvass(latestCanvass)}</p>
              )}
              {noticeContacts && (
                <div class="helper-card">
                  <p><strong>Send written notices to</strong></p>
                  <dl class="record-facts">
                    {listNoticeContactLines(noticeContacts).map((line) => (
                      <div>
                        <dt>{line.label}</dt>
                        <dd>{line.value}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="helper">Saved by a steward on {formatTimelineDate(noticeContacts.updatedAt)}. Check it against your lease.</p>
                </div>
              )}
            </>
          )}
        </aside>
      </main>

      <BlockSkyline />
      <footer class="site-footer">
        <p>This page does not show names, unit numbers, or photos.</p>
        {hasAccess && (
          <p><a href="?forget=1">Forget key on this device</a>. Use this on a shared phone.</p>
        )}
      </footer>
    </div>

    {hasAccess && kv && (
      <div hidden data-dashboard-config data-is-steward={isSteward ? "true" : "false"}></div>
    )}
    <script>
      // Astro bundles this import. The script does nothing when the dashboard is locked.
      import "../../scripts/buildingDashboard.ts";
    </script>
  </body>
</html>
