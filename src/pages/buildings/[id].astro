---
import "../../styles/global.css";
import { issueOptions } from "../../data/noticeData";
import { isAccessKeyValid, isBuildingAccessValid } from "../../lib/access";
import { RESIDENT_KEY_COOKIE, STEWARD_KEY_COOKIE } from "../../lib/api/requestGuard";
import { formatResidentReportCount, type BuildingSubmission } from "../../lib/buildingDashboard";
import { loadBuildingDetail } from "../../lib/buildingDetail";
import { buildFollowUpItems, followUpActionHref, summarizeWins } from "../../lib/followUp";
import { describeCanvass } from "../../lib/canvass";
import { listCanvasses } from "../../lib/storage/canvass";
import { submissionStatusLabels, type SubmissionStatus } from "../../lib/submissions";
import { buildIssuePatterns } from "../../lib/issuePatterns";
import { formatDate } from "../../lib/dateUtils";
import { buildBuildingDashboardUrl, buildSubmissionDetailsUrl } from "../../lib/navigation";
import SeoHead from "../../components/SeoHead.astro";
import AccessKeyPanel from "../../components/AccessKeyPanel.astro";
import AppHeader from "../../components/AppHeader.astro";

export const prerender = false;

const { id } = Astro.params;
const kv = Astro.locals.runtime?.env?.SUBMISSIONS_KV;
const url = new URL(Astro.request.url);
const accessKey = Astro.cookies.get(RESIDENT_KEY_COOKIE)?.value ?? url.searchParams.get("key");
const stewardKey = Astro.cookies.get(STEWARD_KEY_COOKIE)?.value ?? url.searchParams.get("stewardKey");
const requiredStewardKey = Astro.locals.runtime?.env?.STEWARD_KEY;
const buildingId = decodeURIComponent(id ?? "");

const hasAccess = isBuildingAccessValid(buildingId, accessKey, Astro.locals.runtime?.env ?? {});
const hasAccessAttempt = Boolean(accessKey && accessKey.trim());
const isSteward = isAccessKeyValid(stewardKey, requiredStewardKey);

const issueIds = new Set(issueOptions.map((issue) => issue.id));
const statusIds: SubmissionStatus[] = ["open", "resolved", "archived"];

const issueFilterRaw = url.searchParams.get("issue") || "all";
const issueFilter = issueIds.has(issueFilterRaw) ? issueFilterRaw : "all";
const statusFilterRaw = url.searchParams.get("status") || "all";
const statusFilter = statusIds.includes(statusFilterRaw as SubmissionStatus) ? statusFilterRaw : "all";
const hasFilters = issueFilter !== "all" || statusFilter !== "all";
const statusLabels = submissionStatusLabels;

const clearFiltersUrl = buildBuildingDashboardUrl({ buildingId });
const buildFilterUrl = (nextIssue: string, nextStatus: string) => {
  const params = new URLSearchParams();
  if (nextIssue !== "all") {
    params.set("issue", nextIssue);
  }
  if (nextStatus !== "all") {
    params.set("status", nextStatus);
  }
  const query = params.toString();
  return `${clearFiltersUrl}${query ? `?${query}` : ""}`;
};
const clearIssueUrl = buildFilterUrl("all", statusFilter);
const clearStatusUrl = buildFilterUrl(issueFilter, "all");
const activeIssueLabel = issueFilter === "all"
  ? ""
  : (issueOptions.find((issue) => issue.id === issueFilter)?.label ?? issueFilter);
const activeStatusLabel = statusFilter === "all" ? "" : statusLabels[statusFilter as SubmissionStatus];

const today = formatDate(new Date());
// Archived records are left out of the full reads: they are not followed up, and wins are logged on open or resolved records.
const detail =
  hasAccess && kv && buildingId ? await loadBuildingDetail(kv, buildingId, { statuses: ["open", "resolved"] }) : null;
const submissions: BuildingSubmission[] = detail?.summaries ?? [];
const followUpItems = detail ? buildFollowUpItems(detail.records, detail.eventsByRecord, today) : [];
const wins = detail ? summarizeWins(detail.records, detail.eventsByRecord) : { total: 0, afterLetter: 0, after311: 0 };
const latestCanvass = detail && kv ? (await listCanvasses(kv, buildingId))[0] ?? null : null;

const filtered = submissions
  .filter((record) => (issueFilter === "all" ? true : record.issue === issueFilter))
  .filter((record) => (statusFilter === "all" ? true : record.status === statusFilter))
  .sort((left, right) => right.createdAt.localeCompare(left.createdAt));

const maxVisible = 60;
const visibleSubmissions = filtered.slice(0, maxVisible);

const grouped: Record<SubmissionStatus, BuildingSubmission[]> = {
  open: [],
  resolved: [],
  archived: [],
};

for (const record of visibleSubmissions) {
  grouped[record.status].push(record);
}

// Records a steward can merge a duplicate into: same issue type, not already merged.
const mergeTargetsFor = (record: BuildingSubmission) =>
  submissions.filter(
    (candidate) => candidate.id !== record.id && candidate.issue === record.issue && !candidate.mergedInto
  );

const totalVisible = visibleSubmissions.length;
const patterns = buildIssuePatterns(submissions, today);
const totalFiltered = filtered.length;
// The follow-up list stays short so the records below it are easy to reach. The meeting report has all of them.
const followUpShown = followUpItems.slice(0, 5);
const draftNoticeUrl = `/?building=${encodeURIComponent(buildingId)}#builder`;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead
      title="Building dashboard | Building Ledger"
      description="Private building dashboard for resident issue summaries."
      canonicalPath={`/buildings/${encodeURIComponent(buildingId)}`}
      imagePath="/og/private-dashboard.png"
      imageAlt="Building Ledger private resident dashboard preview"
      noindex={true}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AppHeader
      title="Building Ledger"
      subtitle={`Building: ${buildingId || "Not listed"}`}
      backHref="/"
      backLabel="Notice builder"
      statusBadge={hasAccess ? "Verified resident access" : "Access key needed"}
      isSteward={isSteward}
    />
    <div class="page">
      <header class="hero hero-single">
        <div class="hero-main">
          <p class="eyebrow">Building ledger</p>
          <h1>Resident records</h1>
          {hasAccess ? (
            <>
              <div class="hero-actions">
                <a class="button" href={draftNoticeUrl}>＋ Report a problem</a>
                <a class="button button-secondary" href="#records">Me too on a problem</a>
              </div>
              <nav class="fact-tag-row dashboard-tools" aria-label="Group tools">
                <a class="fact-tag" href={`${clearFiltersUrl}/311`}>Group 311 day</a>
                <a class="fact-tag" href={`${clearFiltersUrl}/meeting`}>Meeting report</a>
                <a class="fact-tag" href={`${clearFiltersUrl}/letter`}>Joint letter</a>
                <a class="fact-tag" href={`${clearFiltersUrl}/export`}>Printable summary</a>
                {isSteward && <a class="fact-tag" href={`${clearFiltersUrl}/canvass`}>Canvass tally</a>}
                {isSteward && <a class="fact-tag" href="/steward">Steward tools</a>}
              </nav>
              <p class="helper">Keep it short. No names or unit numbers. Photos stay private.</p>
            </>
          ) : (
            <p class="tagline">Residents only. Open the link from your building group, or enter the key.</p>
          )}
        </div>
      </header>

      <main class="layout" id="main">
        <section class="panel panel-highlight dashboard-grid">
          {!hasAccess ? (
            <AccessKeyPanel
              title="Key required"
              helperLines={[
                "Residents only.",
                `Ask a steward for the current key for ${buildingId || "this building"}.`,
                "Paste the key below and select Continue.",
              ]}
              warning="Do not share the key publicly."
              errorMessage={hasAccessAttempt ? "Key does not match this building." : ""}
              backLabel="Back to notice builder"
            />
          ) : !kv ? (
            <div>
              <h2>Ledger storage is not configured.</h2>
              <p class="helper">Connect the submission store to load building activity.</p>
            </div>
          ) : (
            <>
              {followUpItems.length > 0 && (
                <details class="helper-card follow-up" open>
                  <summary>Needs follow-up ({followUpItems.length})</summary>
                  <div class="helper-card-body">
                    <ul class="fact-list follow-up-list">
                      {followUpShown.map((item) => (
                        <li>
                          <a href={buildSubmissionDetailsUrl({ submissionId: item.recordId })}>{item.issueLabel}</a>: {item.message}{" "}
                          <a class="fact-tag follow-up-action" href={followUpActionHref(item)}>{item.action.label}</a>
                        </li>
                      ))}
                    </ul>
                    {followUpItems.length > followUpShown.length && (
                      <p class="helper">
                        {followUpItems.length - followUpShown.length} more in the <a href={`${clearFiltersUrl}/meeting`}>meeting report</a>.
                      </p>
                    )}
                    <p class="helper">Information only. The next normal step depends on your building. Ask a tenant group or legal aid if you are not sure.</p>
                  </div>
                </details>
              )}

              <div class="ledger-action-bar" id="records">
                <div>
                  <h2 style="margin: 0; font-size: 1.15rem;">Recent records</h2>
                  <p class="helper" style="margin: 0;">Showing {totalVisible} of {totalFiltered} records. Small counts are hidden for privacy.</p>
                </div>
                <a class="button" href={draftNoticeUrl}>＋ Report a problem</a>
              </div>

              <nav class="quick-filter-bar" aria-label="Filter issues by category">
                <a
                  href={buildFilterUrl("all", statusFilter)}
                  class={`fact-tag ${issueFilter === "all" ? "fact-tag-included" : ""}`}
                >
                  All issues ({submissions.length})
                </a>
                {issueOptions.map((opt) => {
                  const count = submissions.filter((s) => s.issue === opt.id).length;
                  if (count === 0 && issueFilter !== opt.id) return null;
                  return (
                    <a
                      href={buildFilterUrl(opt.id, statusFilter)}
                      class={`fact-tag ${issueFilter === opt.id ? "fact-tag-included" : ""}`}
                    >
                      {opt.label} ({count})
                    </a>
                  );
                })}
              </nav>

              {hasFilters && (
                <div class="tag-row" style="margin-bottom: 12px;">
                  {issueFilter !== "all" && (
                    <span>
                      Filtered by issue: {activeIssueLabel}.{" "}
                      <a href={clearIssueUrl}>Clear issue filter</a>
                    </span>
                  )}
                  {statusFilter !== "all" && (
                    <span>
                      Filtered by status: {activeStatusLabel}.{" "}
                      <a href={clearStatusUrl}>Clear status filter</a>
                    </span>
                  )}
                </div>
              )}

              {totalFiltered === 0 ? (
                <p class="helper">No records match these filters.</p>
              ) : (
                statusIds.map((status) => (
                  <section class="status-group" data-status-group={status}>
                    <div class="status-header">
                      <h3>{statusLabels[status]}</h3>
                      <span class="status-pill" data-status-count={status}>{formatResidentReportCount(grouped[status].length)}</span>
                    </div>
                    {grouped[status].length === 0 ? (
                      <p class="helper">No records in this status.</p>
                    ) : (
                      grouped[status].map((record) => (
                        <article class="issue-card" data-submission-id={record.id} data-current-status={record.status}>
                          <div>
                            <p class="issue-title">{record.issueLabel}</p>
                            <p class="issue-meta">
                              Started {record.startDate || "Date not listed"}. Reports:{" "}
                              <span data-report-count={record.id} title="Small counts are hidden for privacy">{formatResidentReportCount(record.reportCount)}</span>.
                            </p>
                            <p class="issue-meta">
                              Last update saved on {record.reportDate || record.createdAt || "Date not listed"}.
                            </p>
                          </div>
                          <div class="issue-actions">
                            {record.mergedInto ? (
                              <p class="helper">Merged into another record.</p>
                            ) : (
                              <button
                                class="button button-compact"
                                type="button"
                                data-report-button
                                data-submission-id={record.id}
                                data-default-label="Me too"
                              >
                                Me too
                              </button>
                            )}
                            <a
                              class="button button-secondary button-compact"
                              href={buildSubmissionDetailsUrl({ submissionId: record.id })}
                            >
                              View details
                            </a>
                          </div>
                          <p class="helper" data-report-status={record.id} role="status" aria-live="polite"></p>
                          {isSteward && !record.mergedInto && (
                            <div class="steward-row">
                              <label class="steward-inline">
                                <span>Update status</span>
                                <select
                                  class="input"
                                  data-status-select
                                  data-submission-id={record.id}
                                >
                                  {statusIds.map((option) => (
                                    <option value={option} selected={record.status === option}>
                                      {statusLabels[option]}
                                    </option>
                                  ))}
                                </select>
                                <button
                                  class="button button-compact"
                                  type="button"
                                  data-status-save
                                  data-submission-id={record.id}
                                  data-default-label="Save"
                                >
                                  Save
                                </button>
                              </label>
                              <p class="helper" data-status-note={record.id} role="status" aria-live="polite"></p>
                              <p class="helper">Use this only after residents confirm the issue is fixed.</p>
                              {mergeTargetsFor(record).length > 0 && (
                                <label class="steward-inline">
                                  <span>Duplicate of</span>
                                  <select class="input" data-merge-select data-submission-id={record.id}>
                                    <option value="">Choose the main record</option>
                                    {mergeTargetsFor(record).map((target) => (
                                      <option value={target.id}>
                                        Started {target.startDate || "date not listed"} ({statusLabels[target.status]})
                                      </option>
                                    ))}
                                  </select>
                                  <button
                                    class="button button-compact button-secondary"
                                    type="button"
                                    data-merge-save
                                    data-submission-id={record.id}
                                  >
                                    Merge
                                  </button>
                                </label>
                              )}
                              <p class="helper" data-merge-note={record.id} role="status" aria-live="polite"></p>
                            </div>
                          )}
                        </article>
                      ))
                    )}
                  </section>
                ))
              )}

              <h2 class="dashboard-overview-title">Overview</h2>
              <div class="summary-grid">
                <div class="summary-card">
                  <p class="summary-label">Total (filtered)</p>
                  <p class="summary-value">{totalFiltered}</p>
                </div>
                <div class="summary-card">
                  <p class="summary-label">Visible now</p>
                  <p class="summary-value">{totalVisible}</p>
                </div>
                <div class="summary-card">
                  <p class="summary-label">Open</p>
                  <p class="summary-value" data-summary-count="open">{formatResidentReportCount(grouped.open.length)}</p>
                </div>
                <div class="summary-card">
                  <p class="summary-label">{statusLabels.resolved}</p>
                  <p class="summary-value" data-summary-count="resolved">{formatResidentReportCount(grouped.resolved.length)}</p>
                </div>
                <div class="summary-card">
                  <p class="summary-label">Archived</p>
                  <p class="summary-value" data-summary-count="archived">{formatResidentReportCount(grouped.archived.length)}</p>
                </div>
                <div class="summary-card">
                  <p class="summary-label">Wins logged</p>
                  <p class="summary-value">{wins.total}</p>
                </div>
              </div>
              {latestCanvass && (
                <p class="helper"><strong>Latest canvass:</strong> {describeCanvass(latestCanvass)}</p>
              )}
              {patterns.rows.length > 0 && (
                <details class="helper-card patterns">
                  <summary>Patterns: records started each month</summary>
                  <div class="helper-card-body">
                    <p class="helper">Last 6 months, by issue type. A problem that comes back shows in many months.</p>
                    <div class="table-scroll">
                      <table class="report-table">
                        <thead>
                          <tr>
                            <th scope="col">Issue</th>
                            {patterns.months.map((month) => <th scope="col">{month.label}</th>)}
                            <th scope="col">Total</th>
                            <th scope="col">Open now</th>
                          </tr>
                        </thead>
                        <tbody>
                          {patterns.rows.map((row) => (
                            <tr>
                              <th scope="row">{row.issueLabel}</th>
                              {row.counts.map((count) => <td>{count}</td>)}
                              <td>{row.total}</td>
                              <td>{row.open}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p class="helper">Counts under 3 show as &lt;3 to protect residents. Merged duplicates are not counted.</p>
                  </div>
                </details>
              )}

            </>
          )}
        </section>

        <aside class="panel sidebar-panel">
          {!hasAccess ? (
            <>
              <div>
                <h2>Why this is private</h2>
                <p class="helper">Building keys keep resident issue records resident-only.</p>
              </div>
              <div class="export-block">
                <h3>Safety notes</h3>
                <ul class="submission-detail-list">
                  <li>This page never shows names or unit numbers.</li>
                  <li>Evidence files stay private.</li>
                  <li>Keys reduce scraping and retaliation risk.</li>
                </ul>
              </div>
            </>
          ) : (
            <>
              <div>
                <h2>Filters</h2>
                <p class="helper">Filter by issue type or status.</p>
              </div>
              <form class="filter-grid" method="get">
                                <label>
                  <span>Issue type</span>
                  <select class="input" name="issue">
                    <option value="all" selected={issueFilter === "all"}>All issues</option>
                    {issueOptions.map((issue) => (
                      <option value={issue.id} selected={issueFilter === issue.id}>
                        {issue.label}
                      </option>
                    ))}
                  </select>
                </label>
                <label>
                  <span>Status</span>
                  <select class="input" name="status">
                    <option value="all" selected={statusFilter === "all"}>All statuses</option>
                    {statusIds.map((status) => (
                      <option value={status} selected={statusFilter === status}>
                        {statusLabels[status]}
                      </option>
                    ))}
                  </select>
                </label>
                <button class="button" type="submit">Apply filters</button>
                {hasFilters && (
                  <a class="button button-secondary" href={clearFiltersUrl}>
                    Clear filters
                  </a>
                )}
              </form>
              <div class="export-block">
                <h3>Notes</h3>
                <ul class="submission-detail-list">
                  <li>Use “Me too” to add your report without writing.</li>
                  <li>Stewards can update status for clear records.</li>
                  <li>Stewards can merge duplicate records. Reports move to the main record.</li>
                  <li>Counts are resident-reported and not verified.</li>
                  <li>Small counts are hidden to protect resident privacy.</li>
                </ul>
              </div>
            </>
          )}
        </aside>
      </main>

      <footer class="site-footer">
        <p>Safety first: this dashboard does not show names, unit numbers, or evidence files.</p>
        {hasAccess && (
          <p><a href="?forget=1">Forget key on this device</a>. Use this on a shared phone.</p>
        )}
      </footer>
    </div>

    {hasAccess && kv && (
      <div hidden data-dashboard-config data-is-steward={isSteward ? "true" : "false"}></div>
    )}
    <script>
      // Astro bundles this import. The script does nothing when the dashboard is locked.
      import "../../scripts/buildingDashboard.ts";
    </script>
  </body>
</html>
