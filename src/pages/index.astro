---
import "../styles/global.css";
import NoticeBuilder from "../components/NoticeBuilder";
import SeoHead from "../components/SeoHead.astro";
import AppHeader from "../components/AppHeader.astro";
import { getBuildingOptions } from "../data/buildings";
import { getBuildingIdsForKey, parseBuildingKeys } from "../lib/access";
import { RESIDENT_KEY_COOKIE } from "../lib/api/requestGuard";

const env = Astro.locals.runtime?.env ?? {};
const buildingKeys = parseBuildingKeys(env.BUILDING_KEYS_JSON);
const buildingOptions = getBuildingOptions(buildingKeys);
// Only building ids reach the client. The key itself stays in the httpOnly cookie.
const residentBuildings = getBuildingIdsForKey(Astro.cookies.get(RESIDENT_KEY_COOKIE)?.value, env);
const hasResidentKey = residentBuildings.length > 0;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead
      title="Building Ledger | Resident issue tracker and notice builder"
      description="Track building repair issues, add me too reports, and create neutral notice drafts with simple forms."
      canonicalPath="/"
      imagePath="/og/home.svg"
      imageAlt="Building Ledger preview card with private issue tracking and notice tools"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AppHeader subtitle="2400 W Wabansia" statusBadge={hasResidentKey ? "Device key active" : undefined} />
    <main class="page" id="main">
      <section class="home-intro-panel" aria-labelledby="home-title">
        <div class="home-intro-copy">
          <p class="eyebrow">Tenant tools • 2400 W Wabansia</p>
          <h1 id="home-title">Issue tracking for residents</h1>
          <p class="home-intro-lead">
            Document building repair issues with facts and dates. Create neutral repair notices for management without legal jargon.
          </p>
          <p class="helper">Use short facts and dates. Choose an issue type to draft or view existing records.</p>
          <div class="hero-actions">
            <a class="button intro-primary-cta" href="#builder">Draft a notice</a>
            <a class="button button-secondary" href="/buildings/2400%20W%20Wabansia">Open 2400 W Wabansia ledger →</a>
          </div>
          <ul class="home-intro-list">
            <li><strong>Private by default:</strong> No names, emails, or phone numbers are saved.</li>
            <li><strong>Factual notices:</strong> Neutral drafts based on dates and conditions.</li>
            <li><strong>Me too count:</strong> Simple participation for neighbors without writing.</li>
          </ul>
        </div>
      </section>

      <NoticeBuilder
        client:load
        buildingOptions={buildingOptions}
        residentBuildings={residentBuildings}
      />
    </main>
  </body>
</html>
