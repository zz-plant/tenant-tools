---
import "../styles/global.css";
import NoticeBuilder from "../components/NoticeBuilder";
import SeoHead from "../components/SeoHead.astro";
import AppHeader from "../components/AppHeader.astro";
import BlockSkyline from "../components/BlockSkyline.astro";
import StreetSign from "../components/StreetSign.astro";
import { getBuildingOptions } from "../data/buildings";
import { getBuildingIdsForKey, parseBuildingKeys } from "../lib/access";
import { RESIDENT_KEY_COOKIE } from "../lib/api/requestGuard";

const env = Astro.locals.env ?? {};
const buildingKeys = parseBuildingKeys(env.BUILDING_KEYS_JSON);
const buildingOptions = getBuildingOptions(buildingKeys);
// Only building ids reach the client. The key itself stays in the httpOnly cookie.
const residentBuildings = getBuildingIdsForKey(Astro.cookies.get(RESIDENT_KEY_COOKIE)?.value, env);
const hasResidentKey = residentBuildings.length > 0;
// A device with a key opens its own building. Without one, the ledger link asks for the key.
const ledgerBuildings = hasResidentKey ? residentBuildings.filter((id) => id !== "*") : [];
const ledgerLinks = (ledgerBuildings.length > 0 ? ledgerBuildings : ["2400 W Wabansia"]).slice(0, 3);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead
      title="Tenant Tools | Resident issue tracker and notice builder"
      description="Track building repair issues, add me too reports, and create neutral notice drafts with simple forms."
      canonicalPath="/"
      imagePath="/og/home.png"
      imageAlt="Tenant Tools preview card with private issue tracking and notice tools"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AppHeader subtitle="Notices and records for tenants" statusBadge={hasResidentKey ? "Device key active" : undefined} />
    <main class="page" id="main">
      <section class="home-intro-panel" aria-labelledby="home-title">
        <div class="home-intro-copy">
          <h1 id="home-title" class="painted">Put it in writing. Act together.</h1>
          <p class="home-intro-lead">
            Write a calm notice to management. Save the dates. Neighbors with the same problem tap “Me too”. No legal words needed.
          </p>
          <div class="hero-actions">
            <a class="button intro-primary-cta" href="#builder">Write a notice</a>
            {ledgerLinks.map((building) => (
              <a class="street-sign-link" href={`/buildings/${encodeURIComponent(building)}`} aria-label={`Open ${building}`}>
                <StreetSign address={building} size="small" />
                <svg class="tool-arrow" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" />
                </svg>
              </a>
            ))}
          </div>
          <ul class="home-intro-list">
            <li><strong>Private</strong> No names, emails, or phone numbers are saved.</li>
            <li><strong>Facts and dates</strong> Notices say what happened and when. Nothing more.</li>
            <li><strong>Me too</strong> Neighbors join a problem without writing.</li>
          </ul>
          <p class="home-links">
            <a href="/rights">Your rights in Chicago: a short printable guide</a>
            <a href="/kit">Start a building group: flyer and first-meeting checklist</a>
          </p>
        </div>
        <BlockSkyline />
      </section>

      <NoticeBuilder
        client:load
        buildingOptions={buildingOptions}
        residentBuildings={residentBuildings}
      />
    </main>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
