---
import "../../styles/global.css";
import { fieldDefinitions, issueOptions, stages, zoneOptions } from "../../data/noticeData";
import { portfolioOptions } from "../../data/portfolioOptions";
import { getBuildingIdsForKey, isResidentKeyRecognized } from "../../lib/access";
import { RESIDENT_KEY_COOKIE, STEWARD_KEY_COOKIE } from "../../lib/api/requestGuard";
import { isAccessKeyValid } from "../../lib/access";
import { getEvidenceConfig } from "../../lib/storage/evidence";
import { formatResidentReportCount } from "../../lib/buildingDashboard";
import { formatDate, formatTimelineDate } from "../../lib/dateUtils";
import { getFairNoticeRule } from "../../data/rules";
import {
  formatRecordEventLabel,
  recordEventDefinitions,
  recordEventGroups,
  recordEventTypes,
} from "../../lib/recordEvents";
import { listRecordEvents } from "../../lib/storage/recordEvents";
import { getSubmissionTimelineEntries } from "../../lib/submissionTimeline";
import { reconcileReportCount } from "../../lib/domain/submissions";
import { countReporterMarkers, fetchSubmissionRecord, saveSubmissionRecord } from "../../lib/storage/submissions";
import { buildBuildingDashboardUrl } from "../../lib/navigation";
import { buildFollowUpItems, daysOpen, nextStepButtonLabel, nextStepForRecord } from "../../lib/followUp";
import { formatIssueLabel } from "../../lib/noticeUtils";
import SeoHead from "../../components/SeoHead.astro";
import AccessKeyPanel from "../../components/AccessKeyPanel.astro";
import AppHeader from "../../components/AppHeader.astro";
import HelpResources from "../../components/HelpResources.astro";

export const prerender = false;

const { id } = Astro.params;
const kv = Astro.locals.env?.SUBMISSIONS_KV;
const url = new URL(Astro.request.url);
const accessKey = Astro.cookies.get(RESIDENT_KEY_COOKIE)?.value ?? url.searchParams.get("key");
const env = Astro.locals.env ?? {};
const hasAccess = isResidentKeyRecognized(accessKey, env);
const hasAccessAttempt = Boolean(accessKey && accessKey.trim());
const rawSubmissionRecord = id && kv && hasAccess ? await fetchSubmissionRecord(kv, id) : null;
const allowedBuildingIds = getBuildingIdsForKey(accessKey, env);
const hasBuildingAccess = rawSubmissionRecord
  ? allowedBuildingIds.includes("*") || allowedBuildingIds.includes(rawSubmissionRecord.building)
  : false;
let submissionRecord = hasAccess && hasBuildingAccess ? rawSubmissionRecord : null;

// Heal a count that lost a concurrent "me too" write. See reconcileReportCount.
if (submissionRecord && kv && !submissionRecord.mergedInto) {
  const reconciled = reconcileReportCount(submissionRecord, await countReporterMarkers(kv, submissionRecord.id));
  if (reconciled.reportCount > submissionRecord.reportCount) {
    await saveSubmissionRecord(kv, reconciled);
    submissionRecord = reconciled;
  }
}
const isSteward = isAccessKeyValid(Astro.cookies.get(STEWARD_KEY_COOKIE)?.value, env.STEWARD_KEY);
const evidenceEnabled = Boolean(getEvidenceConfig(env));
const evidenceCount = submissionRecord?.evidenceCount ?? 0;
const mergedIntoUrl = submissionRecord?.mergedInto
  ? `/submissions/${encodeURIComponent(submissionRecord.mergedInto)}`
  : "";

// Older records saved the label with a leading emoji. formatIssueLabel removes it.
const issueLabel = formatIssueLabel(
  submissionRecord?.issueLabel ||
    issueOptions.find((issue) => issue.id === submissionRecord?.issue)?.label ||
    submissionRecord?.issue ||
    "Issue"
);

const stageLabel = submissionRecord ? stages[submissionRecord.stage] : "";
const detailEntries = submissionRecord ? Object.entries(submissionRecord.issueDetails || {}) : [];
const zoneLabel = zoneOptions.find((option) => option.id === submissionRecord?.zone)?.label || "Not listed";
const portfolioLabel =
  portfolioOptions.find((option) => option.id === submissionRecord?.portfolio)?.label || "Not listed";
const startDateLabel = submissionRecord?.startDate ? formatTimelineDate(submissionRecord.startDate) : "Not listed";
const reportDateLabel = submissionRecord?.reportDate ? formatTimelineDate(submissionRecord.reportDate) : "Not listed";
const reportCountLabel =
  typeof submissionRecord?.reportCount === "number"
    ? formatResidentReportCount(submissionRecord.reportCount)
    : "Not listed";

const dashboardUrl =
  submissionRecord?.building
    ? buildBuildingDashboardUrl({ buildingId: submissionRecord.building })
    : "";

const today = formatDate(new Date());
const recordEvents = submissionRecord && kv ? await listRecordEvents(kv, submissionRecord.id) : [];
const timelineEntries = submissionRecord
  ? getSubmissionTimelineEntries({ ...submissionRecord, events: recordEvents })
  : [];
const fairNoticeRule = getFairNoticeRule(today);
// The same next step as this record's row on the building page: a follow-up item first, then the next notice.
// A notice step opens the builder filled in from this record. Saving there adds a dated fact here.
const nextStep =
  submissionRecord && submissionRecord.status === "open" && !submissionRecord.mergedInto
    ? nextStepForRecord(
        submissionRecord,
        recordEvents,
        today,
        buildFollowUpItems([submissionRecord], new Map([[submissionRecord.id, recordEvents]]), today)
      )
    : null;
const dayCount = submissionRecord ? daysOpen(submissionRecord.startDate || submissionRecord.reportDate, today) : 0;
const isOpen = submissionRecord?.status === "open";
// One-tap choices for the facts residents add most. The full list stays in the menu.
const quickFactTypes = ["management_replied", "repair_date_promised", "repair_completed", "request_311_filed"] as const;
const factTypesByGroup = recordEventGroups.map((group) => ({
  ...group,
  types: recordEventTypes.filter((type) => recordEventDefinitions[type].group === group.id),
}));

// Text for the resident group chat. It never includes the key, the building, or any details.
const groupChatText = submissionRecord
  ? [
      `Building issue saved: ${formatIssueLabel(issueLabel)}.`,
      `Started: ${startDateLabel}.`,
      "If you have this problem too, open the link and tap \u201cMe too\u201d.",
      "No names are saved.",
    ].join("\n")
  : "";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead
      title="Record summary | Tenant Tools"
      description="Private resident record summary with timeline and factual details."
      canonicalPath={`/submissions/${encodeURIComponent(id ?? "")}`}
      imagePath="/og/private-record.png"
      imageAlt="Tenant Tools private issue record summary preview"
      noindex={true}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <AppHeader
      title="Tenant Tools"
      subtitle={submissionRecord?.building ? submissionRecord.building : "Issue record"}
      backHref={dashboardUrl || "/"}
      backLabel={dashboardUrl ? "Building" : "Home"}
      statusBadge={hasAccess ? "Verified access" : "Access key needed"}
      isSteward={isSteward}
    />
    <div class="page">
      <main class="record" id="main">
        {!hasAccess ? (
          <section class="panel">
            <AccessKeyPanel
              title="Access key required"
              helperLines={[
                "This record is private to residents in the building.",
                "The link can include private details.",
                "Ask a resident steward for the key.",
                "If the key is correct and it still does not load, the link may be incorrect or expired.",
              ]}
              warning="Do not share the key or link in public."
              errorMessage={hasAccessAttempt ? "Key does not match this record." : ""}
              backLabel="Back to notice builder"
            />
          </section>
        ) : submissionRecord ? (
          <>
            <header class="record-head" data-issue={submissionRecord.issue}>
              <span class="record-swatch" aria-hidden="true"></span>
              <div class="record-title">
                <h1>{issueLabel}</h1>
                <p class="record-meta">
                  {submissionRecord.building}. Started {startDateLabel}. Me too: {reportCountLabel}.
                  {submissionRecord.status !== "open" && ` ${submissionRecord.status === "resolved" ? "Resolved" : "Archived"}.`}
                </p>
              </div>
              {isOpen && (
                <p class="problem-days record-days" aria-label={`${dayCount} days open`}>
                  <b class="tabular">{dayCount}</b>
                  <span>{dayCount === 1 ? "day" : "days"} open</span>
                </p>
              )}
            </header>

            {mergedIntoUrl ? (
              <div class="merged-notice" role="note">
                <p>This record is a duplicate. A steward merged it into the main record.</p>
                <a class="button" href={mergedIntoUrl}>Open the main record</a>
              </div>
            ) : (
              <section class="next-up" aria-label="Next step">
                {nextStep?.state === "ready" ? (
                  <div class="next-sign">
                    <h2>{nextStep.label}</h2>
                    <p>{nextStep.note ?? "The dates from this record are filled in for you."}</p>
                    <a class="button" href={nextStep.href} data-next-notice={nextStep.opens === "notice" ? "" : undefined}>
                      {nextStepButtonLabel(nextStep)}
                    </a>
                  </div>
                ) : nextStep ? (
                  <div class="next-calm">
                    <h2>{nextStep.label}</h2>
                    <p>Add a dated fact below when something changes.</p>
                  </div>
                ) : null}
                <div class="next-actions">
                  <button class="button button-secondary" type="button" data-me-too data-submission-id={id}>Me too</button>
                  <a class="button button-secondary" href="#facts">Add a dated fact</a>
                </div>
                <p class="helper" data-me-too-status role="status" aria-live="polite">
                  Tap “Me too” if you have this problem. No personal details are saved.
                </p>
              </section>
            )}

            <div class="record-grid">
              <section class="panel" aria-labelledby="timeline-title">
                <h2 id="timeline-title">What happened</h2>
                {timelineEntries.length > 0 ? (
                  <ul class="timeline">
                    {timelineEntries.map((entry) => (
                      <li class={entry.counted ? "is-counted" : undefined}>
                        <p class="timeline-date">{formatTimelineDate(entry.date)}</p>
                        <p class="timeline-label">
                          {entry.label}
                          {entry.counted && <span class="timeline-note">Counted from the rule. Not a reported event.</span>}
                        </p>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="helper">No timeline dates were saved.</p>
                )}
                <p class="helper">Dates are resident-reported and not verified.</p>
              </section>

              {!mergedIntoUrl && (
                <section
                  class="panel no-print"
                  id="facts"
                  aria-labelledby="facts-title"
                  data-record-facts
                  data-submission-id={id}
                  data-today={today}
                  data-fair-notice-tiers={JSON.stringify(fairNoticeRule?.tiers ?? [])}
                >
                  <div>
                    <h2 id="facts-title">Add a dated fact</h2>
                    <p class="helper">What happened after your notice. Dates only. No names. Residents with the building key can see these facts.</p>
                  </div>
                  <div class="fact-tag-row quick-facts" role="group" aria-label="Common facts">
                    {quickFactTypes.map((type) => (
                      <button class="fact-tag" type="button" data-fact-chip={type}>
                        {recordEventDefinitions[type].label}
                      </button>
                    ))}
                  </div>
                  <form class="facts-form" data-facts-form>
                    <label>
                      What happened
                      <select class="input" name="type" data-fact-type required>
                        <option value="">Choose one</option>
                        {factTypesByGroup.map((group) => (
                          <optgroup label={group.label}>
                            {group.types.map((type) => (
                              <option value={type}>{recordEventDefinitions[type].label}</option>
                            ))}
                          </optgroup>
                        ))}
                      </select>
                    </label>
                    <label>
                      <span data-fact-date-label>Date</span>
                      <input class="input" type="date" name="date" value={today} data-fact-date required />
                    </label>
                    <label hidden data-fact-ref-field>
                      <span data-fact-ref-label>Number (optional)</span>
                      <input class="input" type="text" name="ref" maxlength="40" autocomplete="off" data-fact-ref />
                    </label>
                    <div class="helper" hidden data-after-request-note>
                      <p>Keep these dates. The RLTO and Illinois law protect tenants who ask for repairs in good faith.</p>
                      <p>
                        <strong>Other residents with the building key can see this record.</strong>
                        Add this only if you are comfortable with that. You can also keep the date in your own notes.
                      </p>
                    </div>
                    {fairNoticeRule && (
                      <div class="helper-card" hidden data-fair-notice-check>
                        <p><strong>Was the notice on time?</strong> Information only. Nothing in this box is saved.</p>
                        <label>
                          How long have you lived here?
                          <select class="input" data-fair-tier>
                            <option value="">Choose one</option>
                            {fairNoticeRule.tiers.map((tier) => (
                              <option value={tier.id}>{tier.label}</option>
                            ))}
                          </select>
                        </label>
                        <label>
                          Date the rent increase or lease end starts
                          <input class="input" type="date" data-fair-change-date />
                        </label>
                        <p class="helper" data-fair-result role="status" aria-live="polite"></p>
                        <p class="rule-meta">
                          Rule: {fairNoticeRule.section}.{" "}
                          {fairNoticeRule.sources.map((source, index) => (
                            <>
                              {index > 0 && " · "}
                              <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
                            </>
                          ))}
                        </p>
                      </div>
                    )}
                    <button class="button" type="submit" data-fact-submit>Add to timeline</button>
                    <p class="helper" data-fact-status role="status" aria-live="polite"></p>
                  </form>
                  {isSteward && recordEvents.length > 0 && (
                    <div class="steward-row">
                      <p class="helper">Steward: remove a fact that was added by mistake.</p>
                      <ul class="fact-list">
                        {recordEvents.map((event) => (
                          <li>
                            {formatTimelineDate(event.date)}: {formatRecordEventLabel(event)}{" "}
                            <button
                              class="button button-compact button-secondary"
                              type="button"
                              data-fact-remove
                              data-event-id={event.id}
                            >
                              Remove
                            </button>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </section>
              )}

              <section
                class="panel"
                id="evidence"
                aria-labelledby="evidence-title"
                data-evidence={evidenceEnabled ? "" : undefined}
                data-submission-id={id}
                data-is-steward={isSteward ? "true" : "false"}
              >
                <div>
                  <h2 id="evidence-title">Private photos</h2>
                  <p class="helper">Only residents with the key can see them. Photos on file: <span data-evidence-count>{evidenceCount}</span></p>
                </div>
                {!evidenceEnabled ? (
                  <p class="helper">Photo upload is not set up for this site yet.</p>
                ) : (
                  <>
                    <div class="evidence-grid no-print" data-evidence-grid></div>
                    {!mergedIntoUrl && (
                      <form class="evidence-form no-print" data-evidence-form>
                        <div class="evidence-warning" role="note">
                          <p class="evidence-warning-title">Before you upload</p>
                          <p>Do not upload photos with faces, mail labels, unit numbers, leases, or anything with your name.</p>
                          <p>Location and camera details are removed from the photo.</p>
                        </div>
                        <label class="checkbox-label">
                          <input type="checkbox" data-evidence-confirm />
                          I checked the photo. It has no faces, names, mail labels, unit numbers, or leases.
                        </label>
                        <label>
                          Photo (JPEG or PNG, up to 5 MB)
                          <input class="input" type="file" accept="image/jpeg,image/png" data-evidence-file />
                        </label>
                        <button class="button" type="submit" disabled data-evidence-submit>Upload photo</button>
                        <p class="helper" data-evidence-status role="status" aria-live="polite"></p>
                      </form>
                    )}
                  </>
                )}
              </section>

              <section class="panel share-checklist no-print" id="share-checklist" aria-labelledby="share-title">
                <div>
                  <h2 id="share-title">Tell your neighbors</h2>
                  <p class="helper">Check all items before you share. The message has the problem, the start date, and the link. It does not include the key.</p>
                </div>
                <label class="checkbox-label">
                  <input type="checkbox" class="share-check" />
                  I removed names.
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" class="share-check" />
                  I removed unit numbers.
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" class="share-check" />
                  I removed phone numbers and email addresses.
                </label>
                <div class="share-actions">
                  <button class="button" type="button" data-share-chat data-share-text={groupChatText} disabled title="Complete all checks to share">Share in group chat</button>
                  <button class="button button-secondary" type="button" data-copy-link disabled title="Complete all checks to copy the link">Copy this record link</button>
                </div>
                <p class="helper" data-share-status role="status" aria-live="polite">Complete all checks to copy the link.</p>
                <p class="helper">Share only with residents who have the key.</p>
              </section>

              <section class="panel" aria-labelledby="details-title">
                <h2 id="details-title">Details saved</h2>
                <dl class="record-facts">
                  <div><dt>Building</dt><dd>{submissionRecord.building}</dd></div>
                  <div><dt>Where</dt><dd>{zoneLabel}</dd></div>
                  <div><dt>Management</dt><dd>{portfolioLabel}</dd></div>
                  <div><dt>Notice saved</dt><dd>{stageLabel}</dd></div>
                  <div><dt>Start date</dt><dd>{startDateLabel}</dd></div>
                  <div><dt>Report date</dt><dd>{reportDateLabel}</dd></div>
                  {submissionRecord.ticketDate && <div><dt>311 ticket date</dt><dd>{formatTimelineDate(submissionRecord.ticketDate)}</dd></div>}
                  {submissionRecord.ticketNumber && (
                    <div>
                      <dt>311 ticket number</dt>
                      <dd>
                        {submissionRecord.ticketNumber}.{" "}
                        <a class="no-print" href="https://311.chicago.gov/s/" target="_blank" rel="noreferrer">Check a 311 request</a>
                      </dd>
                    </div>
                  )}
                  {detailEntries.map(([key, value]) => (
                    <div>
                      <dt>{fieldDefinitions[key as keyof typeof fieldDefinitions]?.label || key}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
                <p class="helper">Small report counts are hidden for privacy.</p>
                <div class="share-actions no-print">
                  <button class="button button-secondary" type="button" data-print>Print or save as PDF</button>
                  {dashboardUrl && <a class="button button-secondary" href={dashboardUrl}>Back to building</a>}
                </div>
              </section>

              <section class="panel no-print">
                <HelpResources />
              </section>
            </div>
          </>
        ) : (
          <section class="panel">
            <h2>We could not find this record.</h2>
            <p class="helper">Check the link, or confirm you used the correct building key.</p>
            <a class="button" href="/">Back to builder</a>
          </section>
        )}
      </main>

      <footer class="site-footer">
        <p>Review this record before you share it.</p>
        {hasAccess && (
          <p><a href="?forget=1">Forget key on this device</a>. Use this on a shared phone.</p>
        )}
      </footer>
    </div>

    <script>
      import "../../scripts/evidence.ts";
      import "../../scripts/recordFacts.ts";
    </script>
    <script>
      const checks = Array.from(document.querySelectorAll('.share-check'));
      const status = document.querySelector('[data-share-status]');
      const copyButton = document.querySelector('[data-copy-link]');
      const shareButton = document.querySelector('[data-share-chat]');
      const meTooButton = document.querySelector('[data-me-too]');
      const meTooStatus = document.querySelector('[data-me-too-status]');
      const refreshShareStatus = () => {
        if (!status || checks.length === 0) {
          return;
        }
        const done = checks.every((item) => item instanceof HTMLInputElement && item.checked);
        if (copyButton instanceof HTMLButtonElement) {
          copyButton.disabled = !done;
          copyButton.setAttribute('aria-disabled', String(!done));
          copyButton.title = done ? 'Copy this record link' : 'Complete all checks to copy the link';
        }
        if (shareButton instanceof HTMLButtonElement) {
          shareButton.disabled = !done;
          shareButton.setAttribute('aria-disabled', String(!done));
          shareButton.title = done ? 'Share in group chat' : 'Complete all checks to share';
        }
        status.textContent = done ? 'Checklist complete. You can copy the link.' : 'Complete all checks to copy the link.';
      };

      const copyRecordLink = async () => {
        if (!(copyButton instanceof HTMLButtonElement) || copyButton.disabled) {
          return;
        }

        const previousText = copyButton.textContent;
        copyButton.disabled = true;
        copyButton.textContent = 'Copying...';

        try {
          await navigator.clipboard.writeText(`${window.location.origin}${window.location.pathname}`);
          if (status) {
            status.textContent = 'Link copied. Share only with residents who have the key.';
          }
          copyButton.textContent = 'Link copied';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy this record link';
            refreshShareStatus();
          }, 1400);
        } catch {
          if (status) {
            status.textContent = 'Could not copy the link. Copy from the address bar.';
          }
          copyButton.textContent = previousText || 'Copy this record link';
          refreshShareStatus();
        }
      };

      const shareToGroupChat = async () => {
        if (!(shareButton instanceof HTMLButtonElement) || shareButton.disabled) {
          return;
        }
        // The address bar never holds the key: middleware moves it to a cookie and removes it.
        const link = `${window.location.origin}${window.location.pathname}`;
        const text = shareButton.dataset.shareText || '';
        try {
          if (navigator.share) {
            await navigator.share({ text: `${text}\n${link}` });
            if (status) {
              status.textContent = 'Shared. Only residents with the key can open the record.';
            }
            return;
          }
          await navigator.clipboard.writeText(`${text}\n${link}`);
          if (status) {
            status.textContent = 'Message copied. Paste it in the group chat.';
          }
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') {
            return;
          }
          if (status) {
            status.textContent = 'Could not share. Copy the link from the address bar.';
          }
        }
      };

      const addMeToo = async () => {
        if (!(meTooButton instanceof HTMLButtonElement)) {
          return;
        }
        const submissionId = meTooButton.dataset.submissionId;
        if (!submissionId) {
          return;
        }
        meTooButton.disabled = true;
        meTooButton.textContent = 'Saving...';
        try {
          const response = await fetch(`/api/submissions/${encodeURIComponent(submissionId)}/report`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ increment: 1 }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            throw new Error(payload?.error || 'We could not add your report.');
          }
          if (meTooStatus) {
            meTooStatus.textContent = payload.alreadyReported
              ? 'You already added your report on this device.'
              : 'Your report was added. No personal details were saved.';
          }
          meTooButton.textContent = 'Report added';
        } catch (error) {
          if (meTooStatus) {
            meTooStatus.textContent = error instanceof Error ? error.message : 'We could not add your report.';
          }
          meTooButton.disabled = false;
          meTooButton.textContent = 'Me too';
        }
      };

      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
      checks.forEach((item) => item.addEventListener('change', refreshShareStatus));
      if (shareButton instanceof HTMLButtonElement) {
        shareButton.addEventListener('click', shareToGroupChat);
      }
      if (meTooButton instanceof HTMLButtonElement) {
        meTooButton.addEventListener('click', addMeToo);
      }
      if (copyButton instanceof HTMLButtonElement) {
        copyButton.addEventListener('click', copyRecordLink);
      }
      refreshShareStatus();
    </script>
  </body>
</html>
