---
import { issueShortLabels } from "../data/noticeData";
import type { AreaMap } from "../lib/areaMap";

/*
 * Where in the building open problems are. The drawing is one building with four areas: A inside
 * units (both sides, counted together), B hallways and stairs, C the entry, D common areas. It
 * shows no floors. The list under it is the real content; the drawing is hidden from screen readers.
 * Pointing at an area in the list, or tabbing into it, shades that area in the drawing.
 */
export type Props = { map: AreaMap; issueHref: (issue: string) => string };

const { map, issueHref } = Astro.props;
const windows = [58, 100, 228, 270].flatMap((x) => [48, 98, 148].map((y) => ({ x, y })));
const markers = [
  { letter: "A", x: 94, y: 213 },
  { letter: "A", x: 264, y: 213 },
  { letter: "B", x: 179, y: 57 },
  { letter: "C", x: 179, y: 165 },
  { letter: "D", x: 179, y: 271 },
];
---

<section class="area-map no-print" aria-labelledby="area-map-title">
  <h3 id="area-map-title">Where in the building</h3>
  <p class="helper">Open problems by area. All units are counted together. No floors are shown.</p>
  <svg class="area-map-drawing" viewBox="0 0 358 302" aria-hidden="true" focusable="false">
    <rect class="area-line" x="28" y="16" width="302" height="14" />
    <rect class="area-line" x="40" y="29" width="278" height="212" />
    <rect class="area-fill area-zone-hallway" x="150" y="30" width="58" height="210" />
    <path class="area-line" d="M150 30V240M208 30V240" />
    {windows.map((pane) => <rect class="area-line area-pane area-zone-unit_interior" x={pane.x} y={pane.y} width="30" height="34" />)}
    <path class="area-line area-door area-zone-entry" d="M164 240V186H194V240" />
    <path class="area-line" d="M0 241H358" />
    <path class="area-fill area-dashed area-zone-common_area" d="M40 242V300H318V242" />
    {markers.map((marker) => (
      <g>
        <circle class="area-marker" cx={marker.x} cy={marker.y} r="13" />
        <text class="area-marker-text" x={marker.x} y={marker.y} text-anchor="middle" dominant-baseline="central">{marker.letter}</text>
      </g>
    ))}
  </svg>
  <ul class="area-map-list">
    {map.areas.map((area) => (
      <li data-zone={area.zone}>
        <p class="area-map-name"><span class="area-letter" aria-hidden="true">{area.letter}</span>{area.label}</p>
        {area.items.length > 0 ? (
          <ul class="area-map-items">
            {area.items.map((item) => (
              <li>
                <a class="fact-tag issue-filter" data-issue={item.issue} href={issueHref(item.issue)}>
                  {issueShortLabels[item.issue] ?? item.issue}: <b class="tabular">{item.count}</b>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="helper">No open problems list this area.</p>
        )}
      </li>
    ))}
    <li class="area-map-unlisted">
      <span>Area not listed</span>
      <span>{map.notListed} reports. Area is optional.</span>
    </li>
  </ul>
  <p class="helper">Counts are reports, with Me too. Counts under 3 show as &lt;3. This map is not in the printable summary.</p>
</section>
