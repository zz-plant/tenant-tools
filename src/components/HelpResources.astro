---
import { helpResourceGroups, helpResourcesLastReviewed, toTelHref } from "../data/helpResources";
import { rightsStrings } from "../data/i18n/strings";
import { formatDateForLocale } from "../data/rules";
import { englishTranslate, type Translate } from "../lib/i18n/translate";

export type Props = { headingLevel?: "h2" | "h3"; t?: Translate; locale?: string };
const { headingLevel = "h3", t = englishTranslate, locale = "en-US" } = Astro.props;
const Heading = headingLevel;
const SubHeading = headingLevel === "h2" ? "h3" : "h4";
---

<div class="help-resources">
  <Heading>{t("help.title", rightsStrings["help.title"])}</Heading>
  <p class="helper">{t("help.intro", rightsStrings["help.intro"])}</p>
  {helpResourceGroups.map((group) => (
    <div class="help-group">
      <SubHeading>{t(`help.${group.id}.title`, group.title)}</SubHeading>
      {group.note && <p class="helper">{t(`help.${group.id}.note`, group.note)}</p>}
      <ul class="help-list">
        {group.items.map((item, index) => (
          <li>
            <a href={item.url} target="_blank" rel="noreferrer">{item.name}</a>
            <span class="help-description">{t(`help.${group.id}.item.${index}.description`, item.description)}</span>
            {/* A phone number is a full-size button, so a stressed resident can tap it to call. */}
            {item.phone && (
              <a class="help-call" href={toTelHref(item.phone)}>
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M6.5 2.5 8.5 7 6.8 8.3a10 10 0 0 0 4.9 4.9L13 11.5l4.5 2v3a1 1 0 0 1-1.1 1A15 15 0 0 1 2.5 3.6a1 1 0 0 1 1-1.1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
                {item.phone}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
  <p class="rule-meta">
    {t("help.last_checked", rightsStrings["help.last_checked"], { date: formatDateForLocale(helpResourcesLastReviewed, locale) })}
  </p>
</div>
